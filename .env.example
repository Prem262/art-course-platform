# ==============================================================================
# ART COURSE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# In production (Cloudflare Pages, Vercel, etc.), set these in your hosting environment.
# NEVER commit .env or .env.local to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Database & Auth)
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Privileged Service Role Key (SERVER-SIDE ONLY. NEVER expose to browser!)
# Used strictly for server-side admin user creation and management.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# BUNNY.NET STREAM CONFIGURATION (Protected Video Delivery)
# ------------------------------------------------------------------------------
# Found in Bunny Stream -> Video Library -> API & Security
BUNNY_API_KEY=your-bunny-api-key
BUNNY_LIBRARY_ID=your-bunny-video-library-id
BUNNY_TOKEN_KEY=your-url-token-authentication-key
# Pull zone hostname for HLS streaming (e.g. vz-xxxxxx.b-cdn.net)
BUNNY_HOSTNAME=vz-xxxxxx.b-cdn.net

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
